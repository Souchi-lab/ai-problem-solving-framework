# APSF Environment Configuration
# This file is a template. Copy it to `.env` locally and do not commit secrets.

# --- API Keys ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# --- J-Quants API (001c2: data and universe) ---
# Preferred: the "data access API Key" shown in the J-Quants console.
JQUANTS_API_KEY=

# Backward-compatible aliases accepted by the current runner.
JQUANTS_API_TOKEN=
JQUANTS_ID_TOKEN=
JQUANTS_BEARER_TOKEN=

# --- kabu STATION API (001c3: execution and safety) ---
# Start the kabu STATION desktop app before using these values.
# `KABU_API_KEY` is the app-side API key / session credential used by your local integration.
# `KABU_API_BASE_URL` is the local API endpoint exposed by kabu STATION.
KABU_API_KEY=
KABU_API_BASE_URL=http://localhost:18080

# Future option if the live implementation standardizes on password-based token exchange.
KABU_API_PASSWORD=
