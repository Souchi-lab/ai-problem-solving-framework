# APSF — Environment Configuration
# Copy this file to .env and fill in as needed.
# Most settings are OPTIONAL in v0.1 (CLI/Human execution does not require API keys).

# --- Framework Paths (optional) ---
# APSF_ROOT=.
# DEFAULT_RUNS_DIR=runs
# DEFAULT_WORKSPACES_DIR=workspaces
# DEFAULT_TEMPLATE_DIR=runs/_template

# --- API Keys (optional — only needed for future-api executor) ---
# These are NOT required for CLI/Human execution in v0.1.
# Install API extras first: pip install "apsf[api]"
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# --- Default Models (optional — used only if API executor is enabled) ---
# DEFAULT_OPENAI_MODEL=gpt-4o
# DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
# DEFAULT_GEMINI_MODEL=gemini-2.0-flash

# --- kabu Station API (001c3: 自動発注インフラ) ---
# kabu ステーションアプリを起動した状態で使用する。
# API キーは kabu ステーションアプリの「API」タブから取得。
# KABU_API_KEY=
# KABU_API_BASE_URL=http://localhost:18080
